# ============================================================
#  VIRA AI — Environment Variables Template
#  Copy this to .env and fill in your values.
#  NEVER commit the actual .env file.
# ============================================================

# Application
APP_NAME=VIRA AI
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Whisper model (tiny / base / small / medium)
# Start with "base" — downloads ~150 MB, runs on CPU
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# FFmpeg path (leave as "ffmpeg" if it is on your PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Processing
MAX_UPLOAD_SIZE_MB=2000
MAX_CONCURRENT_JOBS=2

# Export quality defaults (CRF 16=best, 23=default, 28=small)
DEFAULT_CRF=18
DEFAULT_PRESET=medium
DEFAULT_AUDIO_BITRATE=192k
